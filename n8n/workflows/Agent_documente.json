        "jsCode": "const userQuestion = $json.chatInput;\nconst contextChunks = items.map(i => i.json.chunk).join('\\n\\n---\\n\\n');\nconst prompt = `You are an expert assistant. Use only these excerpts to answer the question:\n\nDocument excerpts:\n${contextChunks}\n\nUser question:\n${userQuestion}\n\nYour answer:\n`;\nreturn [{ json: { prompt } }];\n"
