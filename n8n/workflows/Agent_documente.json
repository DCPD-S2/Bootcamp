    {
      "parameters": {
        "jsCode": "// Defensive: check we have items input\nif (!items || items.length === 0) {\n  throw new Error('No input items received');\n}\n\n// Extract user question from first item (all should be the same)\nconst userQuestionRaw = items[0].json.chatInput || '';\nconst userQuestion = userQuestionRaw.toLowerCase();\n\n// Helper: tokenize string to array of words (lowercased, punctuation removed)\nfunction tokenize(text) {\n  return text.replace(/[.,?!:;]/g, '').toLowerCase().split(/\\s+/).filter(Boolean);\n}\n\n// Get tokens for question\nconst qTokens = new Set(tokenize(userQuestion));\n\n// Score and rank chunks by keyword overlap with question\nconst scored = items.map(item => {\n  const chunkText = item.json.chunk || '';\n  const chunkTokens = new Set(tokenize(chunkText));\n  // Count common tokens between chunk and question\n  const commonCount = [...qTokens].filter(token => chunkTokens.has(token)).length;\n  return {\n    json: item.json, // pass whole json object forward\n    score: commonCount\n  };\n});\n\n// Sort descending by score to get most relevant chunks first\nscored.sort((a, b) => b.score - a.score);\n\n// Choose top 3 chunks with highest score (or fewer if less than 3)\nconst topChunks = scored.slice(0, 3).map(chunk => ({\n  json: {\n    chunk: chunk.json.chunk,\n    sessionId: chunk.json.sessionId,\n    chatInput: chunk.json.chatInput\n  }\n}));\n\n// Return top chunk items as output for next node\nreturn topChunks;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -352,
        272
      ],
      "id": "7f5e62cf-366a-41b2-9621-acea0dae8a34",
      "name": "Sortare_scor"
    },
    {
      "parameters": {
        "jsCode": "const text = $json.text || '';\nconst chunkSize = 1000;\nconst overlap = 200;\nconst chunks = [];\n\nlet start = 0;\nwhile (start < text.length) {\n  let end = start + chunkSize;\n  if (end > text.length) end = text.length;\n\n  const chunk = text.substring(start, end);\n  chunks.push({ json: { chunk, sessionId: $json.sessionId, chatInput: $json.chatInput } });\n\n  start += chunkSize - overlap;\n}\n\nreturn chunks;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -880,
        464
      ],
      "id": "50b42956-ff0f-492c-bb17-55f31e40733d",
      "name": "Chunk-ing"
