      "parameters": {
        "jsCode": "const text = $input.first().json.chatInput.toLowerCase();\n\n// Regex to extract language, task, and filename\nconst regex = /generate code in (\\w+) that is doing (.+)$/i;\nconst match = text.match(regex);\n\nif (!match) {\n  throw new Error('Input must be in format: generate code in {language} that is doing {task} ');\n}\n\nconst language = match[1].toLowerCase();\nconst task = match[2].trim();\n\nreturn [{\n  json: {\n    language,\n    task,\n\n  }\n}];"
